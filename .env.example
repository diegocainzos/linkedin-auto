# Copy to .env (gitignored) and fill in. Every key is optional.
OPENROUTER_API_KEY=        # Jev compatibility check (https://openrouter.ai/settings/keys); without it every job is applied to
HUNTER_API_KEY=            # hiring team email lookup (https://hunter.io/api-keys); without it no emails
SMTP_HOST=                 # e.g. smtp.gmail.com; without it emails are only saved in jobs.db, not sent
SMTP_PORT=465              # 465 = SSL, anything else = STARTTLS
SMTP_USER=                 # you@gmail.com
SMTP_PASSWORD=             # Gmail: an app password
SMTP_FROM=                 # optional, defaults to SMTP_USER
